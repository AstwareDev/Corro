{
  "$comment": "Corro design tokens. Mirrors tokens.css. The brand is monochrome so that colour only ever encodes evidential status.",
  "color": {
    "light": {
      "bg": "#FAFAF7",
      "surface": "#FFFFFF",
      "border": "#E5E5DF",
      "text": "#121A1D",
      "textMuted": "#5C6469",
      "evidence": {
        "corroborated": { "fg": "#0B6E4F", "bg": "#E6F4EE", "contrast": 6.4 },
        "partial": { "fg": "#9A6212", "bg": "#FBF1E0", "contrast": 5.0 },
        "contradicted": { "fg": "#B3261E", "bg": "#FBEAE8", "contrast": 6.4 },
        "unsourced": { "fg": "#6B7280", "bg": "#F1F2F4", "contrast": 4.7 },
        "citation": { "fg": "#1D4ED8", "bg": "#E8EEFC", "contrast": 6.6 }
      }
    },
    "dark": {
      "bg": "#0E1315",
      "surface": "#161C1F",
      "border": "#262D31",
      "text": "#FAFAF7",
      "textMuted": "#9CA3AF",
      "evidence": {
        "corroborated": { "fg": "#34D399", "bg": "#10261F", "contrast": 9.5 },
        "partial": { "fg": "#F0B429", "bg": "#2A2113", "contrast": 9.8 },
        "contradicted": { "fg": "#F87171", "bg": "#2C1614", "contrast": 6.5 },
        "unsourced": { "fg": "#9CA3AF", "bg": "#1B1F23", "contrast": 7.2 },
        "citation": { "fg": "#60A5FA", "bg": "#131E33", "contrast": 7.1 }
      }
    }
  },
  "font": {
    "display": "Poppins",
    "ui": "Inter",
    "read": "Source Serif 4",
    "mono": "JetBrains Mono"
  },
  "mark": {
    "grid": 1000,
    "apex": [500, 940],
    "rayAnglesFromVertical": [0, -13.5, 13.5, -27, 27, -40.5, 40.5],
    "stroke": { "hairline": 25, "standard": 42, "reduced": 52 },
    "sizeBands": {
      "solid": "<= 32px",
      "reduced": "33-64px",
      "standard": ">= 65px",
      "hairline": "mark >= 4x cap height"
    },
    "clearspace": 0.25
  }
}
