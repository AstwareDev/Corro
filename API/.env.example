# Copy to .env and fill in. Never commit the filled-in copy.

# --- kimi-k3 (default) -------------------------------------------------------
# Free, keyless, unlimited, but throughput varies from fast to ~3-10 tok/s.
# Optional: only set this to point at a different mirror of the free API.
KIMI_FREE_BASE_URL=https://unified-nvidia-api.vercel.app/v1

# --- kimi-k3-fast (fast mode) ------------------------------------------------
# The same model on a self-hosted Modal endpoint. Costs credits; steady speed.
# Leave blank to run free-only: fast mode then reports as unreachable.
MODAL_API_KEY=
KIMI_BASE_URL=https://<your-workspace>--ep-kimi-k3-server.us-west.modal.direct/v1

# --- diffusiongemma-26b (suggestion chips) ------------------------------------
# Google's DiffusionGemma 26B-A4B-it, on the same free keyless endpoint as
# kimi-k3. A microtask model, not a chat option — it only
# drafts the follow-up suggestion chips shown under a response.
# Optional: only set this to point at a different mirror.
DIFFUSIONGEMMA_BASE_URL=https://unified-nvidia-api.vercel.app/v1

# --- gpt-5.6-luna --------------------------------------------------------------
# OpenAI's GPT-5.6 Luna on Experiential Labs' OpenAI-compatible gateway.
# Free on the shared key. Leave the key blank to run without it:
# /models then reports it as unreachable.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# --- qwen3-max -----------------------------------------------------------------
# Qwen 3.8 Max via xKiro's OpenAI-compatible free tier. 1M context, 65K max
# output, text/image/video input. Optional: only set the base URL to point at
# a different mirror.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1

# --- routing -----------------------------------------------------------------
# Which model answers when a request names none, and which one `fast: true` picks.
CORRO_DEFAULT_MODEL=kimi-k3
CORRO_FAST_MODEL=kimi-k3-fast

# Where device-scoped session JSON is written. Default: API/data
CORRO_DATA_DIR=

# Base URL used to build viewUrl links (e.g. https://your-tunnel.example.com).
# Default: http://localhost:<PORT>
CORRO_PUBLIC_URL=

# Which installed browser channel browser_* drives: chrome (default), msedge,
# chromium, chrome-beta. Or point CORRO_BROWSER_PATH at a specific executable.
CORRO_BROWSER_CHANNEL=
CORRO_BROWSER_PATH=

# --- tools -------------------------------------------------------------------
# Inception Labs (Mercury 2)
INCEPTIONLABS_API_KEY=

# Apify — marketplace and social scrapers
APIFY_API_KEY=

# Tavily web search. Multiple keys are pooled and rotated.
TAVILY_1_KEY=
TAVILY_2_KEY=
TAVILY_3_KEY=
TAVILY_4_KEY=
TAVILY_5_KEY=

# ElevenLabs text-to-speech. Multiple keys are pooled and rotated.
ELEVENLABS_1_KEY=
ELEVENLABS_2_KEY=
ELEVENLABS_3_KEY=
# Voice used for read-aloud. Free accounts can only synthesise ElevenLabs'
# built-in default voices; a shared *library* voice ID is refused with 402.
# Leave blank to use the default, or set a library voice and it will be tried
# first and fall back automatically until the plan supports it.
ELEVENLABS_VOICE_ID=

# --- Supermarkets (Armenia) ---------------------------------------------------
# Yerevan City, Parma and SAS all read without a key. Parma and SAS have no API
# at all — their tools read the same public pages a browser gets, so there is
# nothing to configure. Yerevan City registers a guest the way its own front end
# does; pin a device id to reuse the same guests across restarts. Both optional.
YEREVAN_CITY_DEVICE_ID=
YEREVAN_CITY_BASE_URL=https://apishopv2.yerevan-city.am/api

# --- YouTube (no API key) -----------------------------------------------------
# youtube_* reads YouTube's internal Innertube API via youtubei.js — the same
# endpoints YouTube's own web client uses — so no API key is needed anywhere.
# Caches are in-memory only and lost on restart. All values optional.
# Minimum delay between YouTube calls (politeness + IP-block avoidance).
YOUTUBE_MIN_INTERVAL_MS=1200
# Per-kind cache TTLs.
YOUTUBE_CHANNEL_TTL_MS=86400000
YOUTUBE_VIDEOS_TTL_MS=3600000
YOUTUBE_VIDEO_TTL_MS=3600000
YOUTUBE_COMMENTS_TTL_MS=300000
YOUTUBE_TRANSCRIPT_TTL_MS=86400000
